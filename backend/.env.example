# Copy to .env:  cp .env.example .env
# These are DEVELOPMENT defaults and work as they are. Before any real deployment change every
# secret and password (JWT secrets, DB password, admin password).

# ---- App ----
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
SWAGGER_ENABLED=true

# ---- Database (PostgreSQL) ----
# Running with Docker overrides host, user, password and name (see docker-compose.yml).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bidveda
DB_SSL=false
DB_LOGGING=false

# ---- Auth ----
# Two DIFFERENT secrets, 32+ characters each. Generate real ones with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-before-real-use
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-before-real-use
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
THROTTLE_DISABLED=false

# ---- Super admin (created / synced on every boot) ----
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@bidveda.test
SUPER_ADMIN_PASSWORD=SuperAdmin@123

# ---- File uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---- Mail (leave SMTP_HOST empty to only log emails) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bidveda <no-reply@bidveda.test>
