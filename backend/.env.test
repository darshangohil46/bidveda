# Loaded automatically when NODE_ENV=test (jest sets it). Uses a throw-away database.
NODE_ENV=test
PORT=5001
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
SWAGGER_ENABLED=false

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=bidveda_test
DB_SSL=false
DB_LOGGING=false

JWT_ACCESS_SECRET=test_access_secret_test_access_secret_test_access
JWT_REFRESH_SECRET=test_refresh_secret_test_refresh_secret_test_refresh
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=4
THROTTLE_DISABLED=true

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@bidveda.test
SUPER_ADMIN_PASSWORD=SuperAdmin@123

UPLOAD_DIR=./uploads-test
MAX_UPLOAD_MB=10

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bidveda <no-reply@bidveda.test>
