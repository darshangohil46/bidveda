        ],
        "summary": "Create an RFQ as a draft",
        "tags": [
          "RFQs"
        ]
      },
      "get": {
        "operationId": "RfqsController_list",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "type": "number"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Keyword search over title, description and category.",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Buyers only.",
            "schema": {
              "type": "string",
              "enum": [
                "DRAFT",
                "PUBLISHED",
                "CLOSED",
                "AWARDED"
              ]
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "name": "location",
            "required": false,
            "in": "query",
            "description": "Matches city, state, country or pincode.",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "name": "deadlineFrom",
            "required": false,
            "in": "query",
            "description": "Vendors: deadline on or after this instant.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "deadlineTo",
            "required": false,
            "in": "query",
            "description": "Vendors: deadline on or before this instant.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "created_desc",
                "deadline_asc",
                "deadline_desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ],
        "summary": "List RFQs. Buyers get their own (filter by status); vendors get open RFQs (keyword, category, location, deadline).",
        "tags": [
          "RFQs"
        ]
      }
    },
