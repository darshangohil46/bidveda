  "info": {
    "title": "Bidveda Mini RFQ Portal API",
    "description": "Buyers publish RFQs, vendors quote before the deadline, buyers compare and award. Money is always an integer in minor units (paise). Errors: { statusCode, code, message, details? }. Buyer/vendor endpoints use the \"user\" bearer token; /admin endpoints use the \"admin\" token.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "user": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "admin": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SignupDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "8-72 characters with at least one letter and one number."
          },
          "role": {
            "type": "string",
            "enum": [
              "BUYER",
              "VENDOR"
            ]
          },
          "companyName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "phone": {
            "type": "string",
            "description": "International format, e.g. +919876543210.",
            "pattern": "^\\+[1-9]\\d{6,14}$"
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "role",
          "companyName"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Sent by the Next.js server from its HttpOnly cookie."
          }
        }
      },
      "LineItemDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "quantity": {
            "type": "number",
            "description": "Up to 3 decimal places, e.g. 2.5 kg.",
            "maximum": 1000000000,
            "minimum": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          }
        },
        "required": [
          "name",
          "quantity",
          "unit"
        ]
      },
      "CreateRfqDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 5000
          },
          "category": {
            "type": "string",
            "enum": [
              "Office Supplies",
              "Furniture",
              "IT Hardware",
              "Software & Services",
              "Construction Materials",
              "Electrical",
              "Plumbing & Sanitary",
              "Industrial Equipment",
              "Packaging",
              "Logistics",
              "Catering & Hospitality",
              "Printing & Stationery",
              "Safety & PPE",
              "Other"
            ]
          },
          "deliveryAddress": {
            "type": "string",
            "maxLength": 300
          },
          "deliveryCity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "deliveryState": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "deliveryCountry": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "deliveryPincode": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 -]{1,18}[A-Za-z0-9]$"
          },
          "budgetMinor": {
            "type": "number",
            "nullable": true,
            "description": "Optional budget in minor units (paise). Send null to clear it.",
            "minimum": 0,
            "maximum": 100000000000000
          },
          "deadline": {
            "type": "string",
            "description": "ISO 8601 date-time, must be in the future."
          },
          "lineItems": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineItemDto"
            }
          }
        },
        "required": [
          "title",
          "description",
          "category",
          "deliveryCity",
          "deliveryState",
          "deliveryCountry",
          "deliveryPincode",
          "deadline",
          "lineItems"
        ]
      },
      "UpdateRfqDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 5000
          },
          "category": {
            "type": "string",
            "enum": [
              "Office Supplies",
              "Furniture",
              "IT Hardware",
              "Software & Services",
              "Construction Materials",
              "Electrical",
              "Plumbing & Sanitary",
              "Industrial Equipment",
              "Packaging",
              "Logistics",
              "Catering & Hospitality",
              "Printing & Stationery",
              "Safety & PPE",
              "Other"
            ]
          },
          "deliveryAddress": {
            "type": "string",
            "maxLength": 300
          },
          "deliveryCity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "deliveryState": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "deliveryCountry": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "deliveryPincode": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 -]{1,18}[A-Za-z0-9]$"
          },
          "budgetMinor": {
            "type": "number",
            "nullable": true,
            "description": "Optional budget in minor units (paise). Send null to clear it.",
            "minimum": 0,
            "maximum": 100000000000000
          },
          "deadline": {
            "type": "string",
            "description": "ISO 8601 date-time, must be in the future."
          },
          "lineItems": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineItemDto"
            }
          }
        }
      },
      "QuoteItemDto": {
        "type": "object",
        "properties": {
          "lineItemId": {
            "type": "string",
            "format": "uuid"
          },
          "unitPriceMinor": {
            "type": "number",
            "description": "Price per unit in minor units (paise). Integer, so no float rounding anywhere.",
            "minimum": 1,
            "maximum": 1000000000000
          }
        },
        "required": [
          "lineItemId",
          "unitPriceMinor"
        ]
      },
      "UpsertQuoteDto": {
        "type": "object",
        "properties": {
          "items": {
            "description": "Exactly one price for every line item of the RFQ.",
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuoteItemDto"
            }
          },
          "deliveryDays": {
            "type": "number",
            "minimum": 1,
            "maximum": 3650
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "items",
          "deliveryDays"
        ]
      },
      "AwardDto": {
        "type": "object",
        "properties": {
          "quoteId": {
            "type": "string",
            "format": "uuid"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "quoteId"
        ]
      },
      "AdminLoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AdminRefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      }
    }
  }
}
